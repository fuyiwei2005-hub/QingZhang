[Unit]
Description=Hengxu Business Workspace
After=network.target

[Service]
Type=simple
User=hengxu
Group=hengxu
WorkingDirectory=/opt/hengxu
Environment=NODE_ENV=production
Environment=HOME=/opt/hengxu
ExecStart=/usr/bin/node /opt/hengxu/scripts/start-server.mjs --port 5188
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
